{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counterexample-finder",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "ADA_BASE_URL": "https://api.prod.adaptionlabs.ai/api/v1",
    "ADA_MODEL": "qwen3.8-27b",
    "CXF_TOKEN": "CHANGE_ME_TO_A_LONG_RANDOM_STRING"
  }
  // NOTE: the model API key is NOT stored here.
  // Set it as a secret:   wrangler secret put API_KEY
}
